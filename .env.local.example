# Copia este ficheiro para .env.local e preenche com os teus valores reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────
# Dashboard do projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chave secreta — NUNCA expor no browser. Só usada em Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys (usa as chaves "Test mode" primeiro)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Gerado pelo Stripe CLI (dev) ou pelo dashboard ao criar o endpoint (produção)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Emails transacionais (Resend) ────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...
# Sem domínio próprio verificado no Resend, usa este remetente de teste:
EMAIL_FROM=Guedias <onboarding@resend.dev>

# ── Site ──────────────────────────────────────────────────────────────
# URL pública do site (usada nos redirecionamentos do Stripe Checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

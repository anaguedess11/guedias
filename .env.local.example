# Copia este ficheiro para .env.local e preenche com os teus valores reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────
# Dashboard do projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chave secreta — NUNCA expor no browser. Só usada em Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Pagamentos (MB WAY / transferência bancária) ────────────────────────
# Sem gateway de pagamentos nesta fase inicial — o cliente paga por MB WAY
# ou transferência e um admin confirma manualmente em /admin/encomendas.
# Estes valores aparecem na página de confirmação e nos emails ao cliente.
NEXT_PUBLIC_MBWAY_PHONE=9xx xxx xxx
NEXT_PUBLIC_BANK_HOLDER=Nome do titular da conta
NEXT_PUBLIC_BANK_IBAN=PT50 0000 0000 0000 0000 0000 0
NEXT_PUBLIC_BANK_NAME=Nome do banco

# ── Emails transacionais (Resend) ────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...
# Sem domínio próprio verificado no Resend, usa este remetente de teste:
EMAIL_FROM=Guedias <onboarding@resend.dev>

# ── Site ──────────────────────────────────────────────────────────────
# URL pública do site (usada nos links dos emails transacionais)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
